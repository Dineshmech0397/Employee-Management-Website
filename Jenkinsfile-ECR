pipeline {
    agent any

    environment {
        AWS_REGION = 'us-east-1'
        AWS_ACCOUNT_ID = '198023436378'

        BACKEND_REPO = 'employee-management-backend'
        FRONTEND_REPO = 'employee-management-frontend'

        ECS_CLUSTER = 'employee-management-cluster'
        BACKEND_SERVICE = 'backend-service'
        FRONTEND_SERVICE = 'frontend-service'
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Login to Amazon ECR') {
            steps {
                sh '''
                aws ecr get-login-password --region $AWS_REGION | \
                docker login \
                --username AWS \
                --password-stdin \
                $AWS_ACCOUNT_ID.dkr.ecr.$AWS_REGION.amazonaws.com
                '''
            }
        }

        stage('Build Backend Image') {
            steps {
                sh '''
                docker build -t $BACKEND_REPO:latest ./backend
                '''
            }
        }

        stage('Build Frontend Image') {
            steps {
                sh '''
                docker build -t $FRONTEND_REPO:latest ./frontend
                '''
            }
        }

        stage('Tag Images') {
            steps {
                sh '''
                docker tag $BACKEND_REPO:latest \
                $AWS_ACCOUNT_ID.dkr.ecr.$AWS_REGION.amazonaws.com/$BACKEND_REPO:latest

                docker tag $FRONTEND_REPO:latest \
                $AWS_ACCOUNT_ID.dkr.ecr.$AWS_REGION.amazonaws.com/$FRONTEND_REPO:latest
                '''
            }
        }

        stage('Push Backend Image') {
            steps {
                sh '''
                docker push \
                $AWS_ACCOUNT_ID.dkr.ecr.$AWS_REGION.amazonaws.com/$BACKEND_REPO:latest
                '''
            }
        }

        stage('Push Frontend Image') {
            steps {
                sh '''
                docker push \
                $AWS_ACCOUNT_ID.dkr.ecr.$AWS_REGION.amazonaws.com/$FRONTEND_REPO:latest
                '''
            }
        }

        stage('Deploy to Amazon ECS') {
            steps {
                sh '''
                echo "Deploying Backend..."
                aws ecs update-service \
                  --cluster $ECS_CLUSTER \
                  --service $BACKEND_SERVICE \
                  --force-new-deployment

                echo "Deploying Frontend..."
                aws ecs update-service \
                  --cluster $ECS_CLUSTER \
                  --service $FRONTEND_SERVICE \
                  --force-new-deployment
                '''
            }
        }

    }

    post {
        success {
            echo '======================================='
            echo '✅ CI/CD Pipeline Completed Successfully'
            echo '✅ Docker Images Built'
            echo '✅ Images Pushed to Amazon ECR'
            echo '✅ ECS Services Updated'
            echo '======================================='
        }

        failure {
            echo '======================================='
            echo '❌ Pipeline Failed'
            echo 'Please check the Jenkins Console Output.'
            echo '======================================='
        }
    }
}
